# STEP 9 — Multi-Digit Recognition (e.g. phone numbers)
# ============================================================

import cv2

def segment_digits(pil_img, min_area=50):
    """Find individual digit bounding boxes in an image, left to right."""
    arr = np.array(pil_img.convert("L"))

    # Flatten transparency issue is already handled upstream by to_pil()
    # Auto-invert so digits are white on black for contour detection
    if arr.mean() > 127:
        arr = 255 - arr

    # Threshold to a clean binary image
    _, thresh = cv2.threshold(arr.astype('uint8'), 50, 255, cv2.THRESH_BINARY)

    # Dilate slightly so broken strokes (like a loose "5") merge into one blob
    kernel = np.ones((3, 3), np.uint8)
    thresh = cv2.dilate(thresh, kernel, iterations=1)

    contours, _ = cv2.findContours(thresh, cv2.RETR_EXTERNAL, cv2.CHAIN_APPROX_SIMPLE)

    boxes = []
    for c in contours:
        x, y, w, h = cv2.boundingRect(c)
        if w * h >= min_area:
            boxes.append((x, y, w, h))

    # Sort left to right (reading order)
    boxes.sort(key=lambda b: b[0])
    return boxes, arr


def predict_multi_digit(img):
    pil_img = to_pil(img)
    if pil_img is None:
        return None, "Draw or upload a sequence of digits."

    boxes, arr_normalized = segment_digits(pil_img)
    if not boxes:
        return None, "No digits detected — try drawing bolder strokes."

    predictions = []
    vis_img = np.array(pil_img.convert("RGB"))

    for (x, y, w, h) in boxes:
        # Pad a bit around each digit before feeding to the single-digit pipeline
        pad = int(0.2 * max(w, h))
        x0, y0 = max(0, x - pad), max(0, y - pad)
        x1, y1 = min(arr_normalized.shape[1], x + w + pad), min(arr_normalized.shape[0], y + h + pad)

        crop = pil_img.crop((x0, y0, x1, y1))
        x_input = preprocess(crop)  # reuses your existing single-digit preprocessing
        probs = model.predict(x_input, verbose=0)[0]
        pred = int(np.argmax(probs))
        predictions.append(pred)

        # Draw box + label for visualization
        cv2.rectangle(vis_img, (x0, y0), (x1, y1), (255, 0, 0), 2)
        cv2.putText(vis_img, str(pred), (x0, max(0, y0 - 5)),
                    cv2.FONT_HERSHEY_SIMPLEX, 0.8, (255, 0, 0), 2)

    number_str = "".join(map(str, predictions))
    return vis_img, f"🔢 Detected sequence: **{number_str}**"


# --- Gradio UI ---
with gr.Blocks(title="Multi-Digit Recognizer") as demo_multi:
    gr.Markdown("# 🔢📞 Multi-Digit Recognizer\nDraw or upload a sequence of digits (e.g. a phone number).")
    with gr.Tab("✏️ Draw"):
        sketch_multi = gr.Sketchpad(type="pil", label="Draw a number sequence")
        btn_multi1 = gr.Button("Predict", variant="primary")
    with gr.Tab("📁 Upload"):
        upload_multi = gr.Image(type="pil", label="Upload an image")
        btn_multi2 = gr.Button("Predict", variant="primary")

    out_boxes = gr.Image(label="Detected Digits")
    out_text = gr.Textbox(label="Recognized Sequence")

    btn_multi1.click(predict_multi_digit, inputs=sketch_multi, outputs=[out_boxes, out_text])
    btn_multi2.click(predict_multi_digit, inputs=upload_multi, outputs=[out_boxes, out_text])

demo_multi.launch(share=True, debug=True)
